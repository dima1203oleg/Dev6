# Optional: enables Gemini advisor and media-forensics calls. Keyless public analytics still work.
GEMINI_API_KEY=
# Optional: enables Google Maps integration. Keyless public analytics still work.
GOOGLE_MAPS_PLATFORM_KEY=
# Optional: enables Opendatabot lookups. Keyless public analytics still work.
OPENDATABOT_API_KEY=
OPENDATABOT_API_BASE_URL=https://api.opendatabot.ua
OPENDATABOT_TIMEOUT_MS=30000
OPENDATABOT_CONNECT_TIMEOUT_MS=10000
OPENDATABOT_READ_TIMEOUT_MS=20000
OPENDATABOT_MAX_RETRIES=5
OPENDATABOT_MAX_POLL_ATTEMPTS=10
OPENDATABOT_POLL_INTERVAL_MS=2000
OPENDATABOT_MAX_PAGES=5
OPENDATABOT_RATE_5S=20
OPENDATABOT_RATE_1M=100
OPENDATABOT_MAX_CONCURRENT_REQUESTS=10
OPENDATABOT_CACHE_TTL=3600
# Optional: enables YouScore/YouControl lookups. Keyless public analytics still work.
YOUSCORE_API_KEY=
# Optional compatibility alias for YouScore/YouControl. Keyless public analytics still work.
YOUCONTROL_API_KEY=
YOUSCORE_API_BASE_URL=https://api.youcontrol.com.ua
YOUSCORE_TIMEOUT_MS=30000
YOUSCORE_CONNECT_TIMEOUT_MS=10000
YOUSCORE_MAX_RETRIES=5
YOUSCORE_MAX_POLL_ATTEMPTS=10
YOUSCORE_POLL_INTERVAL_MS=2000
YOUSCORE_MAX_PAGES=5
YOUSCORE_RATE_5S=50
YOUSCORE_RATE_1M=200
YOUSCORE_MAX_CONCURRENT_REQUESTS=10
YOUSCORE_CACHE_TTL=3600
