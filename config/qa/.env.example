# QA Environment Variables
# Copy this file to .env and fill in the values

# Environment
NODE_ENV=development
ENVIRONMENT=qa

# Server
PORT=3000
HOST=localhost

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=predator_qa
DB_USER=predator_qa
DB_PASSWORD=predator_qa_password
DB_SSL=false

# API Keys (QA/Test Keys)
GEMINI_API_KEY=your_gemini_api_key_qa
YOUCONTROL_API_KEY=your_youcontrol_api_key_qa
NAIS_API_KEY=your_nais_api_key_qa
TAX_GOV_API_KEY=your_tax_gov_api_key_qa
NAZK_API_TOKEN=your_nazk_api_token_qa
PROZORRO_API_KEY=your_prozorro_api_key_qa
HIBP_API_KEY=your_hibp_api_key_qa

# Firebase (QA)
FIREBASE_PROJECT_ID=predator-qa
FIREBASE_CLIENT_EMAIL=qa@predator-qa.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=your_firebase_private_key_qa
FIREBASE_DATABASE_URL=https://predator-qa.firebaseio.com

# Features
AI_ENABLED=true
MEDIA_ENABLED=true
VIDEO_ENABLED=true
MUSIC_ENABLED=true
