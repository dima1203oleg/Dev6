# Production Environment Variables
# CRITICAL: All values must be set from secure vault
# DO NOT commit actual values to version control

# Environment
NODE_ENV=production
ENVIRONMENT=production

# Server
PORT=${PORT}
HOST=0.0.0.0

# Database (Required - from vault)
DB_HOST=${DB_HOST}
DB_PORT=${DB_PORT}
DB_NAME=${DB_NAME}
DB_USER=${DB_USER}
DB_PASSWORD=${DB_PASSWORD}
DB_SSL=true

# API Keys (Required - from vault)
GEMINI_API_KEY=${GEMINI_API_KEY}
YOUCONTROL_API_KEY=${YOUCONTROL_API_KEY}
NAIS_API_KEY=${NAIS_API_KEY}
TAX_GOV_API_KEY=${TAX_GOV_API_KEY}
NAZK_API_TOKEN=${NAZK_API_TOKEN}
PROZORRO_API_KEY=${PROZORRO_API_KEY}
HIBP_API_KEY=${HIBP_API_KEY}

# Firebase (Production - from vault)
FIREBASE_PROJECT_ID=${FIREBASE_PROJECT_ID}
FIREBASE_CLIENT_EMAIL=${FIREBASE_CLIENT_EMAIL}
FIREBASE_PRIVATE_KEY=${FIREBASE_PRIVATE_KEY}
FIREBASE_DATABASE_URL=${FIREBASE_DATABASE_URL}

# Features
AI_ENABLED=true
MEDIA_ENABLED=true
VIDEO_ENABLED=true
MUSIC_ENABLED=true

# Security (Required)
SECRETS_VAULT_ENABLED=true
AUDIT_LOGGING_ENABLED=true
CSRF_PROTECTION_ENABLED=true
INPUT_VALIDATION_ENABLED=true

# Observability
METRICS_ENABLED=true
TRACING_ENABLED=true
ALERTS_ENABLED=true
