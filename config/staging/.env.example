# Staging Environment Variables
# Copy this file to .env and fill in the values
# All values must be set for staging deployment

# Environment
NODE_ENV=production
ENVIRONMENT=staging

# Server
PORT=3000
HOST=0.0.0.0

# Database (Required)
DB_HOST=${DB_HOST}
DB_PORT=${DB_PORT}
DB_NAME=predator_staging
DB_USER=${DB_USER}
DB_PASSWORD=${DB_PASSWORD}
DB_SSL=true

# API Keys (Required - Use staging/test keys)
GEMINI_API_KEY=${GEMINI_API_KEY}
YOUCONTROL_API_KEY=${YOUCONTROL_API_KEY}
NAIS_API_KEY=${NAIS_API_KEY}
TAX_GOV_API_KEY=${TAX_GOV_API_KEY}
NAZK_API_TOKEN=${NAZK_API_TOKEN}
PROZORRO_API_KEY=${PROZORRO_API_KEY}
HIBP_API_KEY=${HIBP_API_KEY}

# Firebase (Staging)
FIREBASE_PROJECT_ID=predator-staging
FIREBASE_CLIENT_EMAIL=staging@predator-staging.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=${FIREBASE_PRIVATE_KEY}
FIREBASE_DATABASE_URL=https://predator-staging.firebaseio.com

# Features
AI_ENABLED=true
MEDIA_ENABLED=true
VIDEO_ENABLED=true
MUSIC_ENABLED=true

# Security
SECRETS_VAULT_ENABLED=true
AUDIT_LOGGING_ENABLED=true
